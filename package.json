{
  "name": "auto-gl-srls",
  "private": true,
  "version": "0.2.0",
  "description": "AUTO GL SRLS — catalogue de véhicules d'occasion avec API Express/Prisma.",
  "license": "MIT",
  "author": "Amir Mušić",
  "packageManager": "pnpm@10.15.1",
  "engines": { "node": ">=22" },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5221 --strictPort",
    "api": "node server/index.js",
    "dev:full": "concurrently -k -n api,web -c cyan,magenta \"pnpm:api\" \"pnpm:dev\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5221 --strictPort",
    "test": "node --import tsx --test tests/*.test.mjs",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "cloudinary": "2.11.0",
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "express": "4.18.2",
    "express-rate-limit": "7.1.5",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "lucide-react": "0.468.0",
    "multer": "2.1.1",
    "nodemailer": "6.9.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.2",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.21"
  }
}
