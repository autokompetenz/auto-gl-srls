# Copier ce fichier vers .env puis renseigner vos propres valeurs.
# Ne jamais committer le fichier .env.

# Base PostgreSQL (Neon ou équivalent)
# Avec Neon, utiliser l'endpoint direct (host sans -pooler) pour DATABASE_URL :
# les transactions interactives Prisma ne fonctionnent pas via le pooler (P2028).
DATABASE_URL=
DIRECT_URL=

# Sécurité
JWT_SECRET=
PORT=3001
APP_URL=http://127.0.0.1:5221

# Accès administrateur par code (hash bcrypt, jamais le code en clair)
# Générer avec : node -e 'import("bcryptjs").then(b => b.default.hash("VOTRE_CODE", 12).then(console.log))'
ADMIN_CODE_HASH=
# Facultatif : choisit le compte admin associé au code (sinon le premier admin créé)
ADMIN_EMAIL=

# Envoi d'e-mails (Nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=
LEADS_EMAIL=

# Stockage d'images (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Coordonnées bancaires : rien à renseigner ici.
# Elles sont saisies dans l'espace admin (/admin/parametres) puis enregistrées en base.
